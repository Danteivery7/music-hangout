{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "music-hangout",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MusicRoomV2"
      }
    ]
  },
  "exports": {
    "MusicRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MusicRoomV2": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
